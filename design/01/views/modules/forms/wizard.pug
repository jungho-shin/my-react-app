#settings-offcanvas.offcanvas.offcanvas-end.settings-panel.border-0(tabindex='-1' aria-labelledby='settings-offcanvas')
  .offcanvas-header.align-items-start.border-bottom.flex-column
    .pt-1.w-100.mb-6.d-flex.justify-content-between.align-items-start
      div
        h5.mb-2.me-2.lh-sm
          span.fas.fa-palette.me-2.fs-0
          | Theme Customizer
        p.mb-0.fs--1 Explore different styles according to your preferences
      button.btn.p-1.fw-bolder(type='button' data-bs-dismiss='offcanvas' aria-label='Close')
        span.fas.fa-times.fs-0  
    button.btn.btn-phoenix-secondary.w-100(data-theme-control='reset')
      span.fas.fa-arrows-rotate.me-2.fs--2
      | Reset to default
  #themeController.offcanvas-body.scrollbar.px-card
    .setting-panel-item.mt-0
      h5.setting-panel-item-title Color Scheme
      .row.gx-2
        .col-6
          input#themeSwitcherLight.btn-check(name='theme-color' type='radio' value='light' data-theme-control='phoenixTheme')
          label.btn.d-inline-block.btn-navbar-style.fs--1(for='themeSwitcherLight')
            span.mb-2.rounded.d-block
              img.img-fluid.img-prototype.mb-0(src='/images/generic/default-light.png' alt='')
            span.label-text Light
        .col-6
          input#themeSwitcherDark.btn-check(name='theme-color' type='radio' value='dark' data-theme-control='phoenixTheme')
          label.btn.d-inline-block.btn-navbar-style.fs--1(for='themeSwitcherDark')
            span.mb-2.rounded.d-block
              img.img-fluid.img-prototype.mb-0(src='/images/generic/default-dark.png' alt='')
            span.label-text  Dark
    .border.rounded-3.p-4.setting-panel-item.bg-white
      .d-flex.justify-content-between.align-items-center
        h5.setting-panel-item-title.mb-1 RTL 
        .form-check.form-switch.mb-0
          input.form-check-input.ms-auto(type='checkbox' data-theme-control='phoenixIsRTL')
      p.mb-0.text-700 Change text direction
    .border.rounded-3.p-4.setting-panel-item.bg-white
      .d-flex.justify-content-between.align-items-center
        h5.setting-panel-item-title.mb-1 Support Chat 
        .form-check.form-switch.mb-0
          input.form-check-input.ms-auto(type='checkbox' data-theme-control='phoenixSupportChat')
      p.mb-0.text-700 Toggle support chat
    .setting-panel-item
      h5.setting-panel-item-title Navigation Type
      .row.gx-2
        .col-6
          input#navbarPositionVertical.btn-check(name='navigation-type' type='radio' value='vertical' data-theme-control='phoenixNavbarPosition' data-page-url='/documentation/layouts/vertical-navbar')
          label.btn.d-inline-block.btn-navbar-style.fs--1(for='navbarPositionVertical')
            span.mb-2.rounded.d-block
              img.img-fluid.img-prototype.d-dark-none(src='/images/generic/default-light.png' alt='')
              img.img-fluid.img-prototype.d-light-none(src='/images/generic/default-dark.png' alt='')
            span.label-text Vertical
        .col-6
          input#navbarPositionHorizontal.btn-check(name='navigation-type' type='radio' value='horizontal' data-theme-control='phoenixNavbarPosition' data-page-url='/documentation/layouts/horizontal-navbar')
          label.btn.d-inline-block.btn-navbar-style.fs--1(for='navbarPositionHorizontal')
            span.mb-2.rounded.d-block
              img.img-fluid.img-prototype.d-dark-none(src='/images/generic/top-default.png' alt='')
              img.img-fluid.img-prototype.d-light-none(src='/images/generic/top-default-dark.png' alt='')
            span.label-text  Horizontal
        .col-6
          input#navbarPositionCombo.btn-check(name='navigation-type' type='radio' value='combo' data-theme-control='phoenixNavbarPosition' data-page-url='/documentation/layouts/combo-navbar')
          label.btn.d-inline-block.btn-navbar-style.fs--1(for='navbarPositionCombo')
            span.mb-2.rounded.d-block
              img.img-fluid.img-prototype.d-dark-none(src='/images/generic/nav-combo-light.png' alt='')
              img.img-fluid.img-prototype.d-light-none(src='/images/generic/nav-combo-dark.png' alt='')
            span.label-text  Combo
        .col-6
          input#navbarPositionTopDouble.btn-check(name='navigation-type' type='radio' value='dual-nav' data-theme-control='phoenixNavbarPosition' data-page-url='/documentation/layouts/dual-nav')
          label.btn.d-inline-block.btn-navbar-style.fs--1(for='navbarPositionTopDouble')
            span.mb-2.rounded.d-block
              img.img-fluid.img-prototype.d-dark-none(src='/images/generic/dual-light.png' alt='')
              img.img-fluid.img-prototype.d-light-none(src='/images/generic/dual-dark.png' alt='')
            span.label-text  Dual nav
    .setting-panel-item
      h5.setting-panel-item-title Vertical Navbar Appearance
      .row.gx-2
        .col-6
          input#navbar-style-default.btn-check(type='radio' name='config.name' value='default' data-theme-control='phoenixNavbarVerticalStyle')
          label.btn.d-block.w-100.btn-navbar-style.fs--1(for='navbar-style-default')
            img.img-fluid.img-prototype.d-dark-none(src='/images/generic/default-light.png' alt='')
            img.img-fluid.img-prototype.d-light-none(src='/images/generic/default-dark.png' alt='')
            span.label-text.d-dark-none  Default
            span.label-text.d-light-none Default
        .col-6
          input#navbar-style-dark.btn-check(type='radio' name='config.name' value='darker' data-theme-control='phoenixNavbarVerticalStyle')
          label.btn.d-block.w-100.btn-navbar-style.fs--1(for='navbar-style-dark')
            img.img-fluid.img-prototype.d-dark-none(src='/images/generic/vertical-darker.png' alt='')
            img.img-fluid.img-prototype.d-light-none(src='/images/generic/vertical-lighter.png' alt='')
            span.label-text.d-dark-none  Darker
            span.label-text.d-light-none Lighter
    .setting-panel-item
      h5.setting-panel-item-title Horizontal Navbar Shape
      .row.gx-2
        .col-6
          input#navbarShapeDefault.btn-check(name='navbar-shape' type='radio' value='default' data-theme-control='phoenixNavbarTopShape' data-page-url='/documentation/layouts/horizontal-navbar')
          label.btn.d-inline-block.btn-navbar-style.fs--1(for='navbarShapeDefault')
            span.mb-2.rounded.d-block
              img.img-fluid.img-prototype.d-dark-none.mb-0(src='/images/generic/top-default.png' alt='')
              img.img-fluid.img-prototype.d-light-none.mb-0(src='/images/generic/top-default-dark.png' alt='')
            span.label-text Default
        .col-6
          input#navbarShapeSlim.btn-check(name='navbar-shape' type='radio' value='slim' data-theme-control='phoenixNavbarTopShape' data-page-url='/documentation/layouts/horizontal-navbar#horizontal-navbar-slim')
          label.btn.d-inline-block.btn-navbar-style.fs--1(for='navbarShapeSlim')
            span.mb-2.rounded.d-block
              img.img-fluid.img-prototype.d-dark-none.mb-0(src='/images/generic/top-slim.png' alt='')
              img.img-fluid.img-prototype.d-light-none.mb-0(src='/images/generic/top-slim-dark.png' alt='')
            span.label-text  Slim
    .setting-panel-item
      h5.setting-panel-item-title Horizontal Navbar Appearance
      .row.gx-2
        .col-6
          input#navbarTopDefault.btn-check(name='navbar-top-style' type='radio' value='default' data-theme-control='phoenixNavbarTopStyle')
          label.btn.d-inline-block.btn-navbar-style.fs--1(for='navbarTopDefault')
            span.mb-2.rounded.d-block
              img.img-fluid.img-prototype.d-dark-none.mb-0(src='/images/generic/top-default.png' alt='')
              img.img-fluid.img-prototype.d-light-none.mb-0(src='/images/generic/top-style-darker.png' alt='')
            span.label-text Default
        .col-6
          input#navbarTopDarker.btn-check(name='navbar-top-style' type='radio' value='darker' data-theme-control='phoenixNavbarTopStyle')
          label.btn.d-inline-block.btn-navbar-style.fs--1(for='navbarTopDarker')
            span.mb-2.rounded.d-block
              img.img-fluid.img-prototype.d-dark-none.mb-0(src='/images/generic/navbar-top-style-light.png' alt='')
              img.img-fluid.img-prototype.d-light-none.mb-0(src='/images/generic/top-style-lighter.png' alt='')
            span.label-text.d-dark-none Darker
            span.label-text.d-light-none Lighter
