                      td.align-middle.text-end.white-space-nowrap.fw-semi-bold.text-1000.ps-4.py-2 02
                      td.align-middle.text-end.white-space-nowrap.ps-4.fw-semi-bold.text-1000
                        span.badge.badge-phoenix.badge-phoenix-primary +22.12%
                    tr.hover-actions-trigger.btn-reveal-trigger.position-static
                      td.align-middle.white-space-nowrap.fw-semi-bold.text-1000.py-2 Offering
                      td.align-middle.text-end.white-space-nowrap.fw-semi-bold.text-1000.ps-4.py-2 02
                      td.align-middle.text-end.white-space-nowrap.ps-4.fw-semi-bold.text-1000
