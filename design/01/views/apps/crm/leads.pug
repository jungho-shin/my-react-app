doctype html
head
  include ../../partials/head_pre.pug
  // ===============================================
  // Stylesheets
  // ===============================================
  link(href='/vendors/choices/choices.min.css' rel='stylesheet')
  link(href='/vendors/flatpickr/flatpickr.min.css' rel='stylesheet')
  include ../../partials/head_stylesheets.pug
  include ../../partials/head_javascript.pug
// ===============================================
// Main Content
// ===============================================
main#top.main
  include ../../partials/navbar-vertical.pug
  include ../../partials/navbar-top.pug
  include ../../partials/searchbox-modal.pug
  .content
    nav.mb-2(aria-label='breadcrumb')
      ol.breadcrumb.mb-0
        li.breadcrumb-item
          a(href='#!') Page 1
        li.breadcrumb-item
          a(href='#!') Page 2
        li.breadcrumb-item.active Default
    .pb-6
      h2.mb-4 25 Leads
      #lealsTable(data-list='{"valueNames":["name","email","phone","contact","company","date"],"page":10,"pagination":true}')
        .row.g-3.justify-content-between.mb-4
          .col-auto
            .d-md-flex.justify-content-between
              div
                button.btn.btn-primary.me-4
                  span.fas.fa-plus.me-2
                  | Create Lead
                button.btn.btn-link.text-900.px-0
                  span.fa-solid.fa-file-export.fs--1.me-2
                  | Export
          .col-auto
            .d-flex
              .search-box.me-2
                form.position-relative(data-bs-toggle='search' data-bs-display='static')
                  input.form-control.search-input.search(type='search' placeholder='Search by name' aria-label='Search')
                  span.fas.fa-search.search-box-icon
              .flatpickr-input-container.me-2
                input#datepicker.form-control.ps-6.datetimepicker(type='text' data-options='{"dateFormat":"M j, Y","disableMobile":true,"defaultDate":"Mar 1, 2022"}')
                span.uil.uil-calendar-alt.flatpickr-icon.text-700
              button.btn.px-3.btn-phoenix-secondary(type='button' data-bs-toggle='modal' data-bs-target='#filterModal' data-boundary='window' aria-haspopup='true' aria-expanded='false' data-bs-reference='parent')
                span.fa-solid.fa-filter.text-primary(data-fa-transform='down-3')
              #filterModal.modal.fade(tabindex='-1')
                .modal-dialog.modal-dialog-centered
                  .modal-content.border
                    form#addEventForm(autocomplete='off')
                      .modal-header.border-200.p-4
                        h5.modal-title.text-1000.fs-2.lh-sm Filter
                        button.btn.p-1.text-900(type='button' data-bs-dismiss='modal' aria-label='Close')
                          span.fas.fa-times.fs--1
                      .modal-body.pt-4.pb-2.px-4
                        .mb-3
                          label.fw-bold.mb-2.text-1000(for='leadStatus') Lead Status
                          select#leadStatus.form-select
                            option(value='newLead' selected='selected') New Lead
                            option(value='coldLead') Cold Lead
                            option(value='wonLead') Won Lead
                            option(value='canceled') Canceled
                        .mb-3
                          label.fw-bold.mb-2.text-1000(for='createDate') Create Date
                          select#createDate.form-select
                            option(value='today' selected='selected') Today
                            option(value='last7Days') Last 7 Days
                            option(value='last30Days') Last 30 Days
                            option(value='chooseATimePeriod') Choose a time period
                        .mb-3
                          label.fw-bold.mb-2.text-1000(for='designation') Designation
                          select#designation.form-select
                            option(value='VPAccounting' selected='selected') VP Accounting
                            option(value='ceo') CEO
                            option(value='creativeDirector') Creative Director
                            option(value='accountant') Accountant
                            option(value='executiveManager') Executive Manager
                      .modal-footer.d-flex.justify-content-end.align-items-center.px-4.pb-4.border-0.pt-3
                        button.btn.btn-sm.btn-phoenix-primary.px-4.fs--2.my-0(type='submit')
                          span.fas.fa-arrows-rotate.me-2.fs--2
                          | Reset
                        button.btn.btn-sm.btn-primary.px-9.fs--2.my-0(type='submit') Done
        .table-responsive.scrollbar.mx-n1.px-1.border-top
          table.table.fs--1.mb-0.leads-table
            thead
              tr
                th.white-space-nowrap.fs--1.align-middle.ps-0(style='max-width:20px; width:18px;')
                  .form-check.mb-0.fs-0
                    input.form-check-input(type='checkbox' data-bulk-select='{"body":"leal-tables-body"}')
                th.sort.white-space-nowrap.align-middle.text-uppercase.ps-0(scope='col' data-sort='name' style='width:25%;') Name
                th.sort.align-middle.ps-4.pe-5.text-uppercase.border-end(scope='col' data-sort='email' style='width:15%;')
                  .d-inline-flex.flex-center
                    .d-flex.align-items-center.px-1.py-1.bg-success-100.rounded.me-2
                      span.text-success-600.dark__text-success-300(data-feather='mail')
                    span Email
                th.sort.align-middle.ps-4.pe-5.text-uppercase.border-end(scope='col' data-sort='phone' style='width:15%; min-width: 180px;')
                  .d-inline-flex.flex-center
                    .d-flex.align-items-center.px-1.py-1.bg-primary-100.rounded.me-2
                      span.text-primary-600.dark__text-primary-300(data-feather='phone')
                    span Phone
                th.sort.align-middle.ps-4.pe-5.text-uppercase.border-end(scope='col' data-sort='contact' style='width:15%;')
                  .d-inline-flex.flex-center
                    .d-flex.align-items-center.px-1.py-1.bg-info-100.rounded.me-2
                      span.text-info-600.dark__text-info-300(data-feather='user')
                    span Contact name
                th.sort.align-middle.ps-4.pe-5.text-uppercase.border-end(scope='col' data-sort='company' style='width:15%;')
                  .d-inline-flex.flex-center
                    .d-flex.align-items-center.px-1.py-1.bg-warning-100.rounded.me-2
                      span.text-warning-600.dark__text-warning-300(data-feather='grid')
                    span Company name
                th.sort.align-middle.ps-4.pe-5.text-uppercase(scope='col' data-sort='date' style='width:15%;') Create date
                th.sort.text-end.align-middle.pe-0.ps-4(scope='col')
