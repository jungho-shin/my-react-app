                      input#progress.form-check-input(type='checkbox' checked='' data-gantt-progress='data-gantt-progress')
                  .d-flex.align-items-end.flex-1
                    label.form-check-label.mb-0.me-2.lh-1.text-900(for='links') Links
                    .form-check.form-switch.min-h-auto.flex-1.mb-0
                      input#links.form-check-input(type='checkbox' checked='' data-gantt-links='data-gantt-links')
              .col-12.col-sm-auto
                .btn-group(role='group' data-gantt-scale='data-gantt-scale')
