doctype html
head
  include ./partials/head_pre.pug
  // ===============================================
  // Stylesheets
  // ===============================================
  include ./partials/head_stylesheets.pug
  include ./partials/head_javascript.pug
link(href='/vendors/leaflet/leaflet.css' rel='stylesheet')
link(href='/vendors/leaflet.markercluster/MarkerCluster.css' rel='stylesheet')
link(href='/vendors/leaflet.markercluster/MarkerCluster.Default.css' rel='stylesheet')
// ===============================================
// Main Content
// ===============================================
main#top.main
  include ./partials/navbar-vertical.pug
  include ./partials/navbar-top.pug
  include ./partials/searchbox-modal.pug
  .content
    .pb-5
      .row.g-4
        .col-12.col-xxl-6
          .mb-8
            h2.mb-2 Ecommerce Dashboard
            h5.text-700.fw-semi-bold Here&rsquo;s what&rsquo;s going on at your business right now
          .row.align-items-center.g-4
            .col-12.col-md-auto
              .d-flex.align-items-center
                span.fa-stack(style='min-height: 46px;min-width: 46px;')
                  span.fa-solid.fa-square.fa-stack-2x.text-success-300(data-fa-transform='down-4 rotate--10 left-4')
                  span.fa-solid.fa-circle.fa-stack-2x.stack-circle.text-success-100(data-fa-transform='up-4 right-3 grow-2')
                  span.fa-stack-1x.fa-solid.fa-star.text-success(data-fa-transform='shrink-2 up-8 right-6')
                .ms-3
                  h4.mb-0 57 new orders
                  p.text-800.fs--1.mb-0 Awating processing
            .col-12.col-md-auto
              .d-flex.align-items-center
                span.fa-stack(style='min-height: 46px;min-width: 46px;')
                  span.fa-solid.fa-square.fa-stack-2x.text-warning-300(data-fa-transform='down-4 rotate--10 left-4')
                  span.fa-solid.fa-circle.fa-stack-2x.stack-circle.text-warning-100(data-fa-transform='up-4 right-3 grow-2')
                  span.fa-stack-1x.fa-solid.fa-pause.text-warning(data-fa-transform='shrink-2 up-8 right-6')
                .ms-3
                  h4.mb-0 5 orders
                  p.text-800.fs--1.mb-0 On hold
            .col-12.col-md-auto
              .d-flex.align-items-center
                span.fa-stack(style='min-height: 46px;min-width: 46px;')
                  span.fa-solid.fa-square.fa-stack-2x.text-danger-300(data-fa-transform='down-4 rotate--10 left-4')
                  span.fa-solid.fa-circle.fa-stack-2x.stack-circle.text-danger-100(data-fa-transform='up-4 right-3 grow-2')
                  span.fa-stack-1x.fa-solid.fa-xmark.text-danger(data-fa-transform='shrink-2 up-8 right-6')
                .ms-3
                  h4.mb-0 15 products
                  p.text-800.fs--1.mb-0 Out of stock
          hr.bg-200.mb-6.mt-4
          .row.flex-between-center.mb-4.g-3
            .col-auto
              h3 Total sells
              p.text-700.lh-sm.mb-0 Payment received across all channels
            .col-8.col-sm-4
              select#select-gross-revenue-month.form-select.form-select-sm.mt-2
                option Mar 1 - 31, 2022
                option April 1 - 30, 2022
                option May 1 - 31, 2022
          .echart-total-sales-chart(style='min-height:320px;width:100%')
        .col-12.col-xxl-6
          .row.g-3
            .col-12.col-md-6
              .card.h-100
                .card-body
                  .d-flex.justify-content-between
                    div
                      h5.mb-1
                        | Total orders
                        span.badge.badge-phoenix.badge-phoenix-warning.rounded-pill.fs--1.ms-2
                          span.badge-label -6.8%
                      h6.text-700 Last 7 days
                    h4 16,247
                  .d-flex.justify-content-center.px-4.py-6
                    .echart-total-orders(style='height:85px;width:115px')
                  .mt-2
                    .d-flex.align-items-center.mb-2
                      .bullet-item.bg-primary.me-2
                      h6.text-900.fw-semi-bold.flex-1.mb-0 Completed
                      h6.text-900.fw-semi-bold.mb-0 52%
                    .d-flex.align-items-center
                      .bullet-item.bg-primary-100.me-2
                      h6.text-900.fw-semi-bold.flex-1.mb-0 Pending payment
                      h6.text-900.fw-semi-bold.mb-0 48%
            .col-12.col-md-6
              .card.h-100
                .card-body
                  .d-flex.justify-content-between
                    div
                      h5.mb-1
                        | New customers
                        span.badge.badge-phoenix.badge-phoenix-warning.rounded-pill.fs--1.ms-2
                          span.badge-label +26.5%
                      h6.text-700 Last 7 days
                    h4 356
                  .pb-0.pt-4
                    .echarts-new-customers(style='height:180px;width:100%;')
            .col-12.col-md-6
              .card.h-100
                .card-body
                  .d-flex.justify-content-between
                    div
                      h5.mb-2 Top coupons
                      h6.text-700 Last 7 days
                  .pb-4.pt-3
                    .echart-top-coupons(style='height:115px;width:100%;')
                  div
                    .d-flex.align-items-center.mb-2
                      .bullet-item.bg-primary.me-2
                      h6.text-900.fw-semi-bold.flex-1.mb-0 Percentage discount
                      h6.text-900.fw-semi-bold.mb-0 72%
                    .d-flex.align-items-center.mb-2
                      .bullet-item.bg-primary-200.me-2
                      h6.text-900.fw-semi-bold.flex-1.mb-0 Fixed card discount
                      h6.text-900.fw-semi-bold.mb-0 18%
                    .d-flex.align-items-center
                      .bullet-item.bg-info-500.me-2
                      h6.text-900.fw-semi-bold.flex-1.mb-0 Fixed product discount
                      h6.text-900.fw-semi-bold.mb-0 10%
            .col-12.col-md-6
              .card.h-100
                .card-body.d-flex.flex-column
