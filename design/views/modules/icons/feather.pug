doctype html
head
  include ../../partials/head_pre.pug
  // ===============================================
  // Stylesheets
  // ===============================================
  link(href='/vendors/prism/prism-okaidia.css' rel='stylesheet')
  include ../../partials/head_stylesheets.pug
  include ../../partials/head_javascript.pug
// ===============================================
// Main Content
// ===============================================
main#top.main
  include ../../partials/navbar-vertical.pug
  include ../../partials/navbar-top.pug
  include ../../partials/searchbox-modal.pug
  .content
    h2.mb-2.lh-sm Feather Icons
    p.text-700.lead.mb-2 Simply beautiful open source icons
    a.btn.btn-link.p-0(href='https://feathericons.com/' target='_blank')
      | Feather Icons Documentation
      span.ms-1(data-feather='chevron-right')
    .mb-9
      .card.shadow-none.border.border-300.my-5(data-component-card='data-component-card')
        .card-header.p-4.border-bottom.border-300.bg-soft
          .row.g-3.justify-content-between.align-items-end
            .col-12.col-md
              h4.text-900.mb-0(data-anchor='data-anchor') Example
              p.mb-0.mt-2.text-800
                | You can use these icons with color and font-size helper classes like the example below:
            .col.col-md-auto
              nav.nav.nav-underline.justify-content-end.doc-tab-nav.align-items-center(role='tablist')
                a.btn.btn-sm.btn-phoenix-primary.code-btn.ms-2(data-bs-toggle='collapse' href='#example-code' role='button' aria-controls='example-code' aria-expanded='false')
                  span.me-2(data-feather='code')
                  | View code
                a.btn.btn-sm.btn-phoenix-primary.preview-btn.ms-2
                  span.me-2(data-feather='eye')
                  | Preview
        .card-body.p-0
          #example-code.collapse.code-collapse
            pre.scrollbar(style='max-height:420px').
              
          .p-4.code-to-copy
            span.text-danger(data-feather='bell' style='height: 70px; width: 70px;')
      .card.border.border-300.mb-3(data-list='{"valueNames":["icon-list-item"]}')
