doctype html
head
  include ../../../partials/head_pre.pug
  // ===============================================
  // Stylesheets
  // ===============================================
  link(href='/vendors/dropzone/dropzone.min.css' rel='stylesheet')
  link(href='/vendors/choices/choices.min.css' rel='stylesheet')
  link(href='/vendors/flatpickr/flatpickr.min.css' rel='stylesheet')
  include ../../../partials/head_stylesheets.pug
  include ../../../partials/head_javascript.pug
// ===============================================
// Main Content
// ===============================================
main#top.main
  include ../../../partials/navbar-vertical.pug
  include ../../../partials/navbar-top.pug
  include ../../../partials/searchbox-modal.pug
  .content
    nav.mb-2(aria-label='breadcrumb')
      ol.breadcrumb.mb-0
        li.breadcrumb-item
          a(href='/#!') Page 1
        li.breadcrumb-item
          a(href='/#!') Page 2
        li.breadcrumb-item.active Default
    form.mb-9
      .row.g-3.flex-between-end.mb-5
        .col-auto
          h2.mb-2 Add a product
          h5.text-700.fw-semi-bold Orders placed across your store
        .col-auto
          button.btn.btn-phoenix-secondary.me-2.mb-2.mb-sm-0(type='button') Discard
          button.btn.btn-phoenix-primary.me-2.mb-2.mb-sm-0(type='button') Save draft
          button.btn.btn-primary.mb-2.mb-sm-0(type='submit') Publish product
      .row.g-5
        .col-12.col-xl-8
          h4.mb-3 Product Title
          input.form-control.mb-5(type='text' placeholder='Write title here...')
          .mb-6
            h4.mb-3  Product Description
            textarea.tinymce(name='content' data-tinymce='{"height":"15rem","placeholder":"Write a description here..."}')
          h4.mb-3 Display images
          #my-awesome-dropzone.dropzone.dropzone-multiple.p-0.mb-5(data-dropzone='data-dropzone')
            .fallback
              input(name='file' type='file' multiple='multiple')
            .dz-preview.d-flex.flex-wrap
              .border.bg-white.rounded-3.d-flex.flex-center.position-relative.me-2.mb-2(style='height:80px;width:80px;')
                img.dz-image(src='/images/products/23.png' alt='...' data-dz-thumbnail='data-dz-thumbnail')
                a.dz-remove.text-400(href='/#!' data-dz-remove='data-dz-remove')
                  span(data-feather='x')
            .dz-message.text-600(data-dz-message='data-dz-message')
              | Drag your photo here
              span.text-800.px-1 or
              button.btn.btn-link.p-0(type='button') Browse from device
              br
              img.mt-3.me-2(src='/images/icons/image-icon.png' width='40' alt='')
          h4.mb-3 Inventory
          .row.g-0.border-top.border-bottom.border-300
            .col-sm-4
              .nav.flex-sm-column.border-bottom.border-bottom-sm-0.border-end-sm.border-300.fs--1.vertical-tab.h-100.justify-content-between(role='tablist' aria-orientation='vertical')
                a#pricingTab.nav-link.border-end.border-end-sm-0.border-bottom-sm.border-300.text-center.text-sm-start.cursor-pointer.outline-none.d-sm-flex.align-items-sm-center.active(data-bs-toggle='tab' data-bs-target='#pricingTabContent' role='tab' aria-controls='pricingTabContent' aria-selected='true')
                  span.me-sm-2.fs-4.nav-icons(data-feather='tag')
                  span.d-none.d-sm-inline Pricing
                a#restockTab.nav-link.border-end.border-end-sm-0.border-bottom-sm.border-300.text-center.text-sm-start.cursor-pointer.outline-none.d-sm-flex.align-items-sm-center(data-bs-toggle='tab' data-bs-target='#restockTabContent' role='tab' aria-controls='restockTabContent' aria-selected='false')
                  span.me-sm-2.fs-4.nav-icons(data-feather='package')
                  span.d-none.d-sm-inline Restock
                a#shippingTab.nav-link.border-end.border-end-sm-0.border-bottom-sm.border-300.text-center.text-sm-start.cursor-pointer.outline-none.d-sm-flex.align-items-sm-center(data-bs-toggle='tab' data-bs-target='#shippingTabContent' role='tab' aria-controls='shippingTabContent' aria-selected='false')
                  span.me-sm-2.fs-4.nav-icons(data-feather='truck')
                  span.d-none.d-sm-inline Shipping
                a#productsTab.nav-link.border-end.border-end-sm-0.border-bottom-sm.border-300.text-center.text-sm-start.cursor-pointer.outline-none.d-sm-flex.align-items-sm-center(data-bs-toggle='tab' data-bs-target='#productsTabContent' role='tab' aria-controls='productsTabContent' aria-selected='false')
                  span.me-sm-2.fs-4.nav-icons(data-feather='globe')
                  span.d-none.d-sm-inline Global Delivery
                a#attributesTab.nav-link.border-end.border-end-sm-0.border-bottom-sm.border-300.text-center.text-sm-start.cursor-pointer.outline-none.d-sm-flex.align-items-sm-center(data-bs-toggle='tab' data-bs-target='#attributesTabContent' role='tab' aria-controls='attributesTabContent' aria-selected='false')
                  span.me-sm-2.fs-4.nav-icons(data-feather='sliders')
                  span.d-none.d-sm-inline Attributes
                a#advancedTab.nav-link.text-center.text-sm-start.cursor-pointer.outline-none.d-sm-flex.align-items-sm-center(data-bs-toggle='tab' data-bs-target='#advancedTabContent' role='tab' aria-controls='advancedTabContent' aria-selected='false')
                  span.me-sm-2.fs-4.nav-icons(data-feather='lock')
                  span.d-none.d-sm-inline Advanced
            .col-sm-8
              .tab-content.py-3.ps-sm-4.h-100
                #pricingTabContent.tab-pane.fade.show.active(role='tabpanel')
                  h4.mb-3.d-sm-none Pricing
                  .row.g-3
                    .col-12.col-lg-6
                      h5.mb-2.text-1000 Regular price
                      input.form-control(type='text' placeholder='$$$')
                    .col-12.col-lg-6
                      h5.mb-2.text-1000 Sale price
                      input.form-control(type='text' placeholder='$$$')
                #restockTabContent.tab-pane.fade.h-100(role='tabpanel' aria-labelledby='restockTab')
                  .d-flex.flex-column.h-100
                    h5.mb-3.text-1000 Add to Stock
                    .row.g-3.flex-1.mb-4
                      .col-sm-7
                        input.form-control(type='number' placeholder='Quantity')
                      .col-sm
                        button.btn.btn-primary(type='button')
                          span.fa-solid.fa-check.me-1.fs--2
                          | Confirm
                    table
                      thead
                        tr
                          th(style='width: 200px;')
                          th
                      tbody
                        tr
                          td.text-1000.fw-bold.py-1 Product in stock now:
                          td.text-700.fw-semi-bold.py-1
                            | $1,090
                            button.btn.p-0(type='button')
                              span.fa-solid.fa-rotate.text-900.ms-1(style='--phoenix-text-opacity: .6;')
                        tr
                          td.text-1000.fw-bold.py-1 Product in transit:
                          td.text-700.fw-semi-bold.py-1 5000
                        tr
                          td.text-1000.fw-bold.py-1 Last time restocked:
                          td.text-700.fw-semi-bold.py-1 30th June, 2021
                        tr
                          td.text-1000.fw-bold.py-1 Total stock over lifetime:
                          td.text-700.fw-semi-bold.py-1 20,000
                #shippingTabContent.tab-pane.fade.h-100(role='tabpanel' aria-labelledby='shippingTab')
                  .d-flex.flex-column.h-100
                    h5.mb-3.text-1000 Shipping Type
                    .flex-1
                      .mb-4
                        .form-check.mb-1
                          input#fullfilledBySeller.form-check-input(type='radio' name='shippingRadio')
                          label.form-check-label.fs-0.text-900(for='fullfilledBySeller') Fullfilled by Seller
                        .ps-4
                          p.text-800.fs--1.mb-0
                            | You&#xFFFD;&#xFFFD;&#xC16A;l be responsible for product delivery. 
                            br
                            | Any damage or delay during shipping may cost you a Damage fee.
                      .mb-4
                        .form-check.mb-1
                          input#fullfilledByPhoenix.form-check-input(type='radio' name='shippingRadio' checked='checked')
                          label.form-check-label.fs-0.text-900.d-flex.align-items-center(for='fullfilledByPhoenix')
                            | Fullfilled by Phoenix 
                            span.badge.badge-phoenix.badge-phoenix-warning.fs--2.ms-2 Recommended
                        .ps-4
                          p.text-800.fs--1.mb-0
                            | Your product, Our responsibility.
                            br
                            | For a measly fee, we will handle the delivery process for you.
                    p.fs--1.fw-semi-bold.mb-0
                      | See our 
                      a.fw-bold(href='/#!') Delivery terms and conditions 
                      | for details.
                #productsTabContent.tab-pane.fade(role='tabpanel' aria-labelledby='productsTab')
                  h5.mb-3.text-1000 Global Delivery
                  .mb-3
                    .form-check
                      input#worldwideDelivery.form-check-input(type='radio' name='deliveryRadio')
                      label.form-check-label.fs-0.text-900(for='worldwideDelivery') Worldwide delivery
                    .ps-4
                      p.fs--1.mb-0.text-800
                        | Only available with Shipping method: 
                        a(href='/#!') Fullfilled by Phoenix
                  .mb-3
                    .form-check
                      input#selectedCountry.form-check-input(type='radio' name='deliveryRadio' checked='checked')
                      label.form-check-label.fs-0.text-900(for='selectedCountry') Selected Countries
                    .ps-4(style='max-width: 350px;')
                      select#organizerMultiple.form-select.ps-4(data-choices='data-choices' multiple='multiple' data-options='{"removeItemButton":true,"placeholder":true}')
                        option(value='') Type Country name
                        option United States of America
                        option United Kingdom
                        option Canada
                        option Mexico
                  div
                    .form-check
                      input#localDelivery.form-check-input(type='radio' name='deliveryRadio')
                      label.form-check-label.fs-0.text-900(for='localDelivery') Local delivery
                    p.fs--1.ms-4.mb-0.text-800
                      | Deliver to your country of residence 
                      a(href='/#!') Change profile address 
                #attributesTabContent.tab-pane.fade(role='tabpanel' aria-labelledby='attributesTab')
                  h5.mb-3.text-1000 Attributes
                  .form-check
                    input#fragileCheck.form-check-input(type='checkbox')
                    label.form-check-label.text-900.fs-0(for='fragileCheck') Fragile Product
                  .form-check
                    input#biodegradableCheck.form-check-input(type='checkbox')
                    label.form-check-label.text-900.fs-0(for='biodegradableCheck') Biodegradable
                  .mb-3
                    .form-check
                      input#frozenCheck.form-check-input(type='checkbox' checked='checked')
                      label.form-check-label.text-900.fs-0(for='frozenCheck') Frozen Product
                      input.form-control(type='text' placeholder='Max. allowed Temperature' style='max-width: 350px;')
                  .form-check
                    input#productCheck.form-check-input(type='checkbox' checked='checked')
                    label.form-check-label.text-900.fs-0(for='productCheck') Expiry Date of Product
                    input#inventory.form-control.inventory-attributes.datetimepicker(type='text' style='max-width: 350px;' placeholder='d/m/y' data-options='{"disableMobile":true}')
                #advancedTabContent.tab-pane.fade(role='tabpanel' aria-labelledby='advancedTab')
                  h5.mb-3.text-1000 Advanced
                  .row.g-3
                    .col-12.col-lg-6
                      h5.mb-2.text-1000 Product ID Type
                      select.form-select(aria-label='form-select-lg example')
                        option(selected='selected') ISBN
                        option(value='1') UPC
                        option(value='2') EAN
                        option(value='3') JAN
                    .col-12.col-lg-6
                      h5.mb-2.text-1000 Product ID
                      input.form-control(type='text' placeholder='ISBN Number')
        .col-12.col-xl-4
          .row.g-2
            .col-12.col-xl-12
              .card.mb-3
                .card-body
                  h4.card-title.mb-4 Organize
                  .row.gx-3
                    .col-12.col-sm-6.col-xl-12
                      .mb-4
                        .d-flex.flex-wrap.mb-2
                          h5.mb-0.text-1000.me-2 Category
                          a.fw-bold.fs--1(href='/#!') Add new category
                        select.form-select.mb-3(aria-label='category')
                          option(value='men-cloth') Men&apos;s Clothing
                          option(value='women-cloth') Womens&apos;s Clothing
                          option(value='kid-cloth') Kid&apos;s Clothing
                    .col-12.col-sm-6.col-xl-12
                      .mb-4
                        .d-flex.flex-wrap.mb-2
                          h5.mb-0.text-1000.me-2 Vendor
                          a.fw-bold.fs--1(href='/#!') Add new vendor
                        select.form-select.mb-3(aria-label='category')
                          option(value='men-cloth') Men&apos;s Clothing
                          option(value='women-cloth') Womens&apos;s Clothing
                          option(value='kid-cloth') Kid&apos;s Clothing
                    .col-12.col-sm-6.col-xl-12
                      .mb-4
                        h5.mb-2.text-1000 Collection
                        input.form-control.mb-xl-3(type='text' placeholder='Collection')
                    .col-12.col-sm-6.col-xl-12
                      .d-flex.flex-wrap.mb-2
                        h5.mb-0.text-1000.me-2 Tags
                        a.fw-bold.fs--1.lh-sm(href='/#!') View all tags
                      select.form-select(aria-label='category')
                        option(value='men-cloth') Men&apos;s Clothing
                        option(value='women-cloth') Womens&apos;s Clothing
                        option(value='kid-cloth') Kid&apos;s Clothing
            .col-12.col-xl-12
              .card
                .card-body
                  h4.card-title.mb-4 Variants
                  .row.g-3
                    .col-12.col-sm-6.col-xl-12
                      .border-bottom.border-dashed.border-sm-0.border-bottom-xl.pb-4
                        .d-flex.flex-wrap.mb-2
                          h5.text-1000.me-2 Option 1
                          a.fw-bold.fs--1(href='/#!') Remove
                        select.form-select.mb-3
                          option(value='size') Size
                          option(value='color') Color
                          option(value='weight') Weight
                          option(value='smell') Smell
                        .product-variant-select-menu
                          select.form-select.mb-3(data-choices='data-choices' multiple='multiple' data-options='{"removeItemButton":true,"placeholder":true}')
                            option(value='size') 4x6 in
                            option(value='color') 9x6 in
                            option(value='weight') 11x8 in
                    .col-12.col-sm-6.col-xl-12
                      .d-flex.flex-wrap.mb-2
                        h5.text-1000.me-2 Option 2
                        a.fw-bold.fs--1(href='/#!') Remove
                      select.form-select.mb-3
                        option(value='size') Size
                        option(value='color') Color
                        option(value='weight') Weight
                        option(value='smell') Smell
                      .product-variant-select-menu.mb-3
                        select.form-select.mb-3(data-choices='data-choices' multiple='multiple' data-options='{"removeItemButton":true,"placeholder":true}')
                          option(value='size') 4x6 in
                          option(value='color') 9x6 in
                          option(value='weight') 11x8 in
                  button.btn.btn-phoenix-primary.w-100(type='button') Add another option
    include ../../../partials/footer.pug
  script.
    var navbarTopStyle = window.config.config.phoenixNavbarTopStyle;
    var navbarTop = document.querySelector('.navbar-top');
    if (navbarTopStyle === 'darker') {
    navbarTop.classList.add('navbar-darker');
    }
    var navbarVerticalStyle = window.config.config.phoenixNavbarVerticalStyle;
    var navbarVertical = document.querySelector('.navbar-vertical');
    if (navbarVertical && navbarVerticalStyle === 'darker') {
    navbarVertical.classList.add('navbar-darker');
    }
  .support-chat-container
    .container-fluid.support-chat
      .card.bg-white
        .card-header.d-flex.flex-between-center.px-4.py-3.border-bottom
          h5.mb-0.d-flex.align-items-center.gap-2
            | Demo widget
            span.fa-solid.fa-circle.text-success.fs--3
          .btn-reveal-trigger
            button#support-chat-dropdown.btn.btn-link.p-0.dropdown-toggle.dropdown-caret-none.transition-none.d-flex(type='button' data-bs-toggle='dropdown' data-boundary='window' aria-haspopup='true' aria-expanded='false' data-bs-reference='parent')
              span.fas.fa-ellipsis-h.text-900
            .dropdown-menu.dropdown-menu-end.py-2(aria-labelledby='support-chat-dropdown')
              a.dropdown-item(href='/#!') Request a callback
              a.dropdown-item(href='/#!') Search in chat
              a.dropdown-item(href='/#!') Show history
              a.dropdown-item(href='/#!') Report to Admin
              a.dropdown-item.btn-support-chat(href='/#!') Close Support
        .card-body.chat.p-0
          .d-flex.flex-column-reverse.scrollbar.h-100.p-3
            .text-end.mt-6
              a.mb-2.d-inline-flex.align-items-center.text-decoration-none.text-1100.hover-bg-soft.rounded-pill.border.border-primary.py-2.ps-4.pe-3(href='/#!')
                p.mb-0.fw-semi-bold.fs--1 I need help with something
                span.fa-solid.fa-paper-plane.text-primary.fs--1.ms-3
              a.mb-2.d-inline-flex.align-items-center.text-decoration-none.text-1100.hover-bg-soft.rounded-pill.border.border-primary.py-2.ps-4.pe-3(href='/#!')
                p.mb-0.fw-semi-bold.fs--1 I can&#xFFFD;&#xFFFD;&#xC173; reorder a product I previously ordered
                span.fa-solid.fa-paper-plane.text-primary.fs--1.ms-3
              a.mb-2.d-inline-flex.align-items-center.text-decoration-none.text-1100.hover-bg-soft.rounded-pill.border.border-primary.py-2.ps-4.pe-3(href='/#!')
                p.mb-0.fw-semi-bold.fs--1 How do I place an order?
                span.fa-solid.fa-paper-plane.text-primary.fs--1.ms-3
              a.false.d-inline-flex.align-items-center.text-decoration-none.text-1100.hover-bg-soft.rounded-pill.border.border-primary.py-2.ps-4.pe-3(href='/#!')
                p.mb-0.fw-semi-bold.fs--1 My payment method not working
                span.fa-solid.fa-paper-plane.text-primary.fs--1.ms-3
            .text-center.mt-auto
              .avatar.avatar-3xl.status-online
                img.rounded-circle.border.border-3.border-white(src='/images/team/30.webp' alt='')
              h5.mt-2.mb-3 Eric
              p.text-center.text-black.mb-0 Ask us anything &#xFFFD;&#xFFFD;&#xFFFD; we&#xFFFD;&#xFFFD;&#xC16A;l get back to you here or by email within 24 hours.
        .card-footer.d-flex.align-items-center.gap-2.border-top.ps-3.pe-4.py-3
          .d-flex.align-items-center.flex-1.gap-3.border.rounded-pill.px-4
            input.form-control.outline-none.border-0.flex-1.fs--1.px-0(type='text' placeholder='Write message')
            label.btn.btn-link.d-flex.p-0.text-500.fs--1.border-0(for='supportChatPhotos')
              span.fa-solid.fa-image
            input#supportChatPhotos.d-none(type='file' accept='image/*')
            label.btn.btn-link.d-flex.p-0.text-500.fs--1.border-0(for='supportChatAttachment')
              span.fa-solid.fa-paperclip
            input#supportChatAttachment.d-none(type='file')
          button.btn.p-0.border-0.send-btn
            span.fa-solid.fa-paper-plane.fs--1
    button.btn.p-0.border.border-200.btn-support-chat
      span.fs-0.btn-text.text-primary.text-nowrap Chat demo
      span.fa-solid.fa-circle.text-success.fs--1.ms-2
      span.fa-solid.fa-chevron-down.text-primary.fs-1
// ===============================================
// End of Main Content
// ===============================================
#settings-offcanvas.offcanvas.offcanvas-end.settings-panel.border-0(tabindex='-1' aria-labelledby='settings-offcanvas')
  .offcanvas-header.align-items-start.border-bottom.flex-column
    .pt-1.w-100.mb-6.d-flex.justify-content-between.align-items-start
      div
        h5.mb-2.me-2.lh-sm
          span.fas.fa-palette.me-2.fs-0
          | Theme Customizer
        p.mb-0.fs--1 Explore different styles according to your preferences
      button.btn.p-1.fw-bolder(type='button' data-bs-dismiss='offcanvas' aria-label='Close')
        span.fas.fa-times.fs-0  
    button.btn.btn-phoenix-secondary.w-100(data-theme-control='reset')
      span.fas.fa-arrows-rotate.me-2.fs--2
      | Reset to default
  #themeController.offcanvas-body.scrollbar.px-card
    .setting-panel-item.mt-0
      h5.setting-panel-item-title Color Scheme
      .row.gx-2
        .col-6
          input#themeSwitcherLight.btn-check(name='theme-color' type='radio' value='light' data-theme-control='phoenixTheme')
          label.btn.d-inline-block.btn-navbar-style.fs--1(for='themeSwitcherLight')
            span.mb-2.rounded.d-block
              img.img-fluid.img-prototype.mb-0(src='/images/generic/default-light.png' alt='')
            span.label-text Light
        .col-6
          input#themeSwitcherDark.btn-check(name='theme-color' type='radio' value='dark' data-theme-control='phoenixTheme')
          label.btn.d-inline-block.btn-navbar-style.fs--1(for='themeSwitcherDark')
            span.mb-2.rounded.d-block
              img.img-fluid.img-prototype.mb-0(src='/images/generic/default-dark.png' alt='')
            span.label-text  Dark
    .border.rounded-3.p-4.setting-panel-item.bg-white
      .d-flex.justify-content-between.align-items-center
        h5.setting-panel-item-title.mb-1 RTL 
        .form-check.form-switch.mb-0
          input.form-check-input.ms-auto(type='checkbox' data-theme-control='phoenixIsRTL')
      p.mb-0.text-700 Change text direction
    .border.rounded-3.p-4.setting-panel-item.bg-white
      .d-flex.justify-content-between.align-items-center
        h5.setting-panel-item-title.mb-1 Support Chat 
        .form-check.form-switch.mb-0
          input.form-check-input.ms-auto(type='checkbox' data-theme-control='phoenixSupportChat')
      p.mb-0.text-700 Toggle support chat
    .setting-panel-item
      h5.setting-panel-item-title Navigation Type
      .row.gx-2
        .col-6
          input#navbarPositionVertical.btn-check(name='navigation-type' type='radio' value='vertical' data-theme-control='phoenixNavbarPosition' data-page-url='/documentation/layouts/vertical-navbar')
          label.btn.d-inline-block.btn-navbar-style.fs--1(for='navbarPositionVertical')
            span.mb-2.rounded.d-block
              img.img-fluid.img-prototype.d-dark-none(src='/images/generic/default-light.png' alt='')
              img.img-fluid.img-prototype.d-light-none(src='/images/generic/default-dark.png' alt='')
            span.label-text Vertical
        .col-6
          input#navbarPositionHorizontal.btn-check(name='navigation-type' type='radio' value='horizontal' data-theme-control='phoenixNavbarPosition' data-page-url='/documentation/layouts/horizontal-navbar')
          label.btn.d-inline-block.btn-navbar-style.fs--1(for='navbarPositionHorizontal')
            span.mb-2.rounded.d-block
              img.img-fluid.img-prototype.d-dark-none(src='/images/generic/top-default.png' alt='')
              img.img-fluid.img-prototype.d-light-none(src='/images/generic/top-default-dark.png' alt='')
            span.label-text  Horizontal
        .col-6
          input#navbarPositionCombo.btn-check(name='navigation-type' type='radio' value='combo' data-theme-control='phoenixNavbarPosition' data-page-url='/documentation/layouts/combo-navbar')
          label.btn.d-inline-block.btn-navbar-style.fs--1(for='navbarPositionCombo')
            span.mb-2.rounded.d-block
              img.img-fluid.img-prototype.d-dark-none(src='/images/generic/nav-combo-light.png' alt='')
              img.img-fluid.img-prototype.d-light-none(src='/images/generic/nav-combo-dark.png' alt='')
