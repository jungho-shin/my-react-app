                          span.fa-solid.fa-bars.kanban-column-icon.text-700.fs--1
                          label.ps-6(for='create-board-wizard-column1') COLUMN 1
                          span.fa-solid.fa-circle-xmark.text-300.position-absolute.top-50.end-0.translate-middle-y.me-2
                      .ms-3
                        input#create-board-wizard-color-column1.kanban-color-picker(type='color' name='column1Color' value='#6E7891')
                    .kanban-column-item
                      .kanban-column-input-container.flex-grow-1
