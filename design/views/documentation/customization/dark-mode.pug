// ===============================================
// Main Content
// ===============================================
main#top.main
  include ../../partials/navbar-vertical.pug
  include ../../partials/navbar-top.pug
  include ../../partials/searchbox-modal.pug
  .content
    h2.mb-2.lh-sm Dark Mode
    p.text-700.lead.mb-2
      | It&#xFFFD;&#xFFFD;&#xC172; effortless to switch Dark Mode in Phoenix. You can enable Dark Mode by default or create a Dark/Light switch if you want. To set the default mode &quot;Dark&quot;, please see the 
      a(href='/documentation/customization/configuration') configuration page
      | .
    .card.shadow-none.border.border-300.my-5(data-component-card='data-component-card')
      .card-header.p-4.border-bottom.border-300.bg-soft
        .row.g-3.justify-content-between.align-items-end
          .col-12.col-md
            h4.text-900.mb-0 Toggle Dark Mode
            p.mb-0.mt-2.text-800
              | Toggling dark mode is very easy in Phoenix. You can toggle dark or light mode by using checkbox, radio input, switch input and custom icon component.
          .col.col-md-auto
            nav.nav.nav-underline.justify-content-end.doc-tab-nav.align-items-center(role='tablist')
              button.btn.btn-link.px-2.text-900.copy-code-btn(type='button')
                span.fas.fa-copy.me-1
                | Copy Code
              a.btn.btn-sm.btn-phoenix-primary.code-btn.ms-2(data-bs-toggle='collapse' href='#toggle-dark-mode-code' role='button' aria-controls='toggle-dark-mode-code' aria-expanded='false')
                span.me-2(data-feather='code')
                | View code
              a.btn.btn-sm.btn-phoenix-primary.preview-btn.ms-2
                span.me-2(data-feather='eye')
                | Preview
      .card-body.p-0
        #toggle-dark-mode-code.collapse.code-collapse
          pre.scrollbar(style='max-height:420px').
            
        .p-4.code-to-copy
          .row
            .col
              h5.fs-0.mb-2 Checkbox 
              .form-check
                input#flexCheckDefault.form-check-input(type='checkbox' data-theme-control='phoenixTheme')
                label.form-check-label(for='flexCheckDefault') Dark mode
            .col
              h5.fs-0.mb-2 Switch Input
              .form-check.form-switch.ps-0
                input#switchDarkModeExample.form-check-input.ms-0.me-2(type='checkbox' data-theme-control='phoenixTheme')
                label(for='switchDarkModeExample') Dark Mode
            .col
              h5.fs-0.mb-2 Radio button
              .form-check.form-check-inline
                input#flexRadioDefault1.form-check-input(type='radio' value='light' data-theme-control='phoenixTheme')
                label.form-check-label(for='flexRadioDefault1') Light
              .form-check.form-check-inline
                input#flexRadioDefault2.form-check-input(type='radio' value='dark' data-theme-control='phoenixTheme')
                label.form-check-label(for='flexRadioDefault2') Dark
            .col
              h5.fs-0.mb-2 Custom icon
              .theme-control-toggle.fa-ion-wait.pe-2
                input#themeControlToggleDoc.form-check-input.ms-0.theme-control-toggle-input(type='checkbox' data-theme-control='phoenixTheme' value='dark')
                label.mb-0.theme-control-toggle-label.theme-control-toggle-light(for='themeControlToggleDoc' data-bs-toggle='tooltip' data-bs-placement='left' title='Switch theme')
                  span.icon(data-feather='moon')
                label.mb-0.theme-control-toggle-label.theme-control-toggle-dark(for='themeControlToggleDoc' data-bs-toggle='tooltip' data-bs-placement='left' title='Switch theme')
                  span.icon(data-feather='sun')
    .card.shadow-none.border.border-300.my-5(data-component-card='data-component-card')
      .card-header.p-4.border-bottom.border-300.bg-soft
        .row.g-3.justify-content-between.align-items-center
          .col-12.col-md
            h4.text-900.mb-0 If you are using gulp based workflow
      .card-body.p-0
        #if-you-are-using-gulp-based-workflow-code.collapse.code-collapse
          pre.scrollbar(style='max-height:420px').
            
        .p-4.code-to-copy
          h5.mb-2 Modify Dark colors using SCSS
          p.mb-0
            | You can find all the variables used to create the dark mode in 
            code /src/scss/theme/root/_dark.scss
            |  file. If you want to override a variable, copy that variable to your 
            code /src/scss/user.scss
            |  file and update it as you see fit. When you change the variable with scss, make sure that the gulp is running.
    .card.shadow-none.border.border-300.my-5(data-component-card='data-component-card')
      .card-header.p-4.border-bottom.border-300.bg-soft
        .row.g-3.justify-content-between.align-items-center
          .col-12.col-md
            h4.text-900.mb-0 If you are not using gulp based workflow
      .card-body.p-0
        #if-you-are-not-using-gulp-based-workflow-code.collapse.code-collapse
          pre.scrollbar(style='max-height:420px').
            
        .p-4.code-to-copy
          h5.mb-2 Modify Dark colors using CSS
          p
            | You can find all the CSS variables used to create the dark mode in 
            code /public/stylesheets/theme.css
            |  file. Look for the class 
            code :root.dark
            |  and you will see all the available variables. If you want to override a variable, copy that variable to your 
            code /public/stylesheets/user.css
            |  file and update it as you see fit.
          pre.language-css.
            
    .card.shadow-none.border.border-300.my-5(data-component-card='data-component-card')
      .card-header.p-4.border-bottom.border-300.bg-soft
        .row.g-3.justify-content-between.align-items-center
          .col-12.col-md
            h4.text-900.mb-0 Using the Dark CSS classes in HTML
      .card-body.p-0
        #using-the-dark-css-classes-in-html-code.collapse.code-collapse
          pre.scrollbar(style='max-height:420px').
            
        .p-4.code-to-copy
          h5.mb-3 You can keep a style constant regardless of current (light or dark) mode
          p
            | If you want a component to retain it&#xFFFD;&#xFFFD;&#xC172; color (light or dark) as it is regardless of the current mode, you can use the following classes -
          p
            code .light
            |  - It will keep the color light even if the current mode is dark
          p
            code .dark
            |  - It will keep the color dark even if the current mode is light
          p The following two examples illustrate the color persistency -
          .row.gx-3
            .col-lg-6
              h5 Keep the color light even if the current mode is dark
              .card.bg-100.light
                .card-body
                  p.mb-0.text-700
                    b This element will retain its color if you switch between light and dark modes.
              pre.mt-2.
                
            .col-lg-6
              h5 Keep the color dark even if the current mode is light
              .card.bg-100.dark
                .card-body
                  p.mb-0.text-700
                    b This element will retain its color if you switch between light and dark modes.
              pre.mt-2.
                
          h6.fs-0.mt-4 Override Background and Text color only for dark mode
          p
            | If you want to use a different text color or background color rather than the default dark theme color for any element, you can use the special &quot;dark&quot; classes:
          ul
            li
              code dark__bg-* 
            li
              code dark__text-* 
          p The following element illustrates the example:
          .card.bg-light.dark__bg-primary
            .card-body
              p.mb-0
                span.fw-bold
                  | This element will get different bg color rather than the default dark theme color.
          pre.mt-2.
            
    .card.shadow-none.border.border-300.my-5(data-component-card='data-component-card')
      .card-header.p-4.border-bottom.border-300.bg-soft
        .row.g-3.justify-content-between.align-items-center
          .col-12.col-md
            h4.text-900.mb-0 Emit JavaScript event on color scheme change
      .card-body.p-0
        #emit-javascript-event-on-color-scheme-change-code.collapse.code-collapse
          pre.scrollbar(style='max-height:420px').
            
        .p-4.code-to-copy
          p
            | When you switch between the dark and light mode, or change any settings from the global theme config at runtime, we emit an event 
            code clickControl
            | .
            br
            | We used this event to update colors using JavaScript. For example, the charts change their colors using this event. You can catch and use this event with the following code snippet:
          pre.
            
    .position-fixed.bottom-0.end-0.p-3(style='z-index: 5')
      #icon-copied-toast.toast.align-items-center.text-white.bg-dark.border-0.light(role='alert' aria-live='assertive' aria-atomic='true')
        .d-flex
          .toast-body.p-3
          button.btn-close.btn-close-white.me-2.m-auto(type='button' data-bs-dismiss='toast' aria-label='Close')
    include ../../partials/footer.pug
  script.
    var navbarTopStyle = window.config.config.phoenixNavbarTopStyle;
    var navbarTop = document.querySelector('.navbar-top');
    if (navbarTopStyle === 'darker') {
    navbarTop.classList.add('navbar-darker');
    }
    var navbarVerticalStyle = window.config.config.phoenixNavbarVerticalStyle;
    var navbarVertical = document.querySelector('.navbar-vertical');
    if (navbarVertical && navbarVerticalStyle === 'darker') {
    navbarVertical.classList.add('navbar-darker');
    }
  .support-chat-container
    .container-fluid.support-chat
      .card.bg-white
        .card-header.d-flex.flex-between-center.px-4.py-3.border-bottom
          h5.mb-0.d-flex.align-items-center.gap-2
            | Demo widget
            span.fa-solid.fa-circle.text-success.fs--3
          .btn-reveal-trigger
            button#support-chat-dropdown.btn.btn-link.p-0.dropdown-toggle.dropdown-caret-none.transition-none.d-flex(type='button' data-bs-toggle='dropdown' data-boundary='window' aria-haspopup='true' aria-expanded='false' data-bs-reference='parent')
              span.fas.fa-ellipsis-h.text-900
            .dropdown-menu.dropdown-menu-end.py-2(aria-labelledby='support-chat-dropdown')
              a.dropdown-item(href='#!') Request a callback
              a.dropdown-item(href='#!') Search in chat
              a.dropdown-item(href='#!') Show history
              a.dropdown-item(href='#!') Report to Admin
              a.dropdown-item.btn-support-chat(href='#!') Close Support
        .card-body.chat.p-0
          .d-flex.flex-column-reverse.scrollbar.h-100.p-3
            .text-end.mt-6
              a.mb-2.d-inline-flex.align-items-center.text-decoration-none.text-1100.hover-bg-soft.rounded-pill.border.border-primary.py-2.ps-4.pe-3(href='#!')
                p.mb-0.fw-semi-bold.fs--1 I need help with something
                span.fa-solid.fa-paper-plane.text-primary.fs--1.ms-3
              a.mb-2.d-inline-flex.align-items-center.text-decoration-none.text-1100.hover-bg-soft.rounded-pill.border.border-primary.py-2.ps-4.pe-3(href='#!')
                p.mb-0.fw-semi-bold.fs--1 I can&#xFFFD;&#xFFFD;&#xC173; reorder a product I previously ordered
                span.fa-solid.fa-paper-plane.text-primary.fs--1.ms-3
              a.mb-2.d-inline-flex.align-items-center.text-decoration-none.text-1100.hover-bg-soft.rounded-pill.border.border-primary.py-2.ps-4.pe-3(href='#!')
                p.mb-0.fw-semi-bold.fs--1 How do I place an order?
                span.fa-solid.fa-paper-plane.text-primary.fs--1.ms-3
              a.false.d-inline-flex.align-items-center.text-decoration-none.text-1100.hover-bg-soft.rounded-pill.border.border-primary.py-2.ps-4.pe-3(href='#!')
                p.mb-0.fw-semi-bold.fs--1 My payment method not working
                span.fa-solid.fa-paper-plane.text-primary.fs--1.ms-3
            .text-center.mt-auto
              .avatar.avatar-3xl.status-online
                img.rounded-circle.border.border-3.border-white(src='/images/team/30.webp' alt='')
              h5.mt-2.mb-3 Eric
              p.text-center.text-black.mb-0 Ask us anything &#xFFFD;&#xFFFD;&#xFFFD; we&#xFFFD;&#xFFFD;&#xC16A;l get back to you here or by email within 24 hours.
        .card-footer.d-flex.align-items-center.gap-2.border-top.ps-3.pe-4.py-3
          .d-flex.align-items-center.flex-1.gap-3.border.rounded-pill.px-4
            input.form-control.outline-none.border-0.flex-1.fs--1.px-0(type='text' placeholder='Write message')
            label.btn.btn-link.d-flex.p-0.text-500.fs--1.border-0(for='supportChatPhotos')
              span.fa-solid.fa-image
            input#supportChatPhotos.d-none(type='file' accept='image/*')
            label.btn.btn-link.d-flex.p-0.text-500.fs--1.border-0(for='supportChatAttachment')
              span.fa-solid.fa-paperclip
            input#supportChatAttachment.d-none(type='file')
          button.btn.p-0.border-0.send-btn
            span.fa-solid.fa-paper-plane.fs--1
    button.btn.p-0.border.border-200.btn-support-chat
      span.fs-0.btn-text.text-primary.text-nowrap Chat demo
      span.fa-solid.fa-circle.text-success.fs--1.ms-2
      span.fa-solid.fa-chevron-down.text-primary.fs-1
